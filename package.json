{
	"name": "regelverk.org",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"dev": "node scripts/commits.mjs && node scripts/manifest.mjs && vite dev",
		"build": "node scripts/commits.mjs && node scripts/manifest.mjs && vite build && node scripts/wrap-worker.mjs",
		"preview": "wrangler dev --port 4173",
		"prepare": "node scripts/commits.mjs; node scripts/manifest.mjs; paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy url cookie baseLocale --emit-ts-declarations --silent; svelte-kit sync || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy url cookie baseLocale --emit-ts-declarations --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright install && playwright test",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"verify": "pnpm check && pnpm lint && pnpm exec playwright install chromium && pnpm test:unit -- --run && pnpm build",
		"verify:full": "pnpm verify && pnpm test:e2e",
		"gen": "wrangler types",
		"scan:laws": "node scripts/scan-laws.mjs",
		"scan:standards": "node scripts/scan-standards.mjs",
		"export:manual": "node scripts/export-manual-pages.mjs",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "latest",
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "^3.2.1",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.65.0",
		"@shadcn-svelte/primitives": "^0.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^5.1.0",
		"bits-ui": "^2.20.6",
		"cn": "^0.5.2",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"formsnap": "^2.1.0",
		"globals": "^17.14.0",
		"layerchart": "^2.9.2",
		"mdsvex": "^0.12.7",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"playwright": "^1.65.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"remixicon-svelte": "^0.0.5",
		"shadcn-svelte": "^1.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"sveltekit-superforms": "^3.1.0",
		"tailwind-variants": "^4.0.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.72.1",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.6",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.158.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"minisearch": "7.2.0",
		"yaml": "^2.9.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"sharp",
			"workerd",
			"esbuild"
		],
		"overrides": {
			"postcss-selector-parser@<7.1.6": ">=7.1.6"
		}
	}
}
