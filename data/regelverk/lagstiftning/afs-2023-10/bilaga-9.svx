p> [W/m<sup>2</sup>]</div></div></td></tr><tr><td><div><div>1&nbsp;800–2&nbsp;600</div></div></td><td><div><div>E = 10<sup>12</sup> [W/m<sup>2</sup>]</div></div></td></tr><tr><td><div><div>2&nbsp;600–10<sup>6</sup></div></div></td><td><div><div>E = 10<sup>11</sup> [W/m<sup>2</sup>]</div></div></td></tr></tbody></table>

